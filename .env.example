# Supabase project settings used by Next.js browser and server code.
# Use the root project URL, e.g. https://your-project-ref.supabase.co (not /rest/v1/).
# These two values are intentionally public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values: never prefix with NEXT_PUBLIC and never commit a real value.
# Use the Supabase `sb_secret_...` key only in FastAPI or server-only code.
SUPABASE_SECRET_KEY=

# CV Backend URL (http://localhost:8000 for local dev, Hugging Face Spaces URL for production).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret for backend auth. Generate a random value and set it in Hugging Face
# Spaces secrets and Vercel environment variables. Never expose it with NEXT_PUBLIC_.
BACKEND_API_KEY=your-secret-key-here
