# Supabase project settings (safe to expose only the public URL and publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values: never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# FastAPI service URL, configured when the CV backend is deployed.
NEXT_PUBLIC_API_URL=http://localhost:8000
